# Required for live LLM generation and OpenAI TTS. Never commit the real key.
OPENAI_API_KEY=

# A cost-conscious model that supports the Responses API and Structured Outputs.
OPENAI_MODEL=gpt-5.4-mini

# Optional overrides
OUTPUT_ROOT=output
LOG_LEVEL=INFO

# Optional Japanese font override for rendered video text.
THOUGHT_PIPELINE_FONT=

# TikTok analytics automation
# Create a TikTok Developer app with Desktop Login Kit + Display API.
# Minimum scopes: user.info.basic,video.list
# Recommended additional scopes: user.info.stats,user.info.profile
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic,video.list,user.info.stats,user.info.profile
TIKTOK_REDIRECT_URI=http://127.0.0.1:8765/callback/
TIKTOK_ACCOUNT_KEY=1minshiko
TIKTOK_MAX_POSTS=100

# Generate with: python scripts/tiktok_analytics.py keygen
# Keep this secret and configure the same value in GitHub Actions.
TIKTOK_TOKEN_ENCRYPTION_KEY=

# Optional one-time bootstrap fallback if an encrypted token file does not yet exist.
# Prefer the local `authorize` command and do not commit this value.
TIKTOK_REFRESH_TOKEN=
